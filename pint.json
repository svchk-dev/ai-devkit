{
    "preset": "laravel",
    "cache-file": "tmp/pint.cache",
    "exclude": [
        "vendor",
        "node_modules",
        "tmp"
    ],
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": false,
        "static_lambda": true,
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "method_public",
                "method_protected",
                "method_private"
            ],
            "sort_algorithm": "none"
        }
    }
}
